# Copy this file to .env and adjust as needed for local development.
# docker-compose.yml reads these values; the api service also reads them at runtime.

# --- PostgreSQL ---
POSTGRES_USER=friendly_marks
POSTGRES_PASSWORD=friendly_marks_dev_password
POSTGRES_DB=friendly_marks
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://friendly_marks:friendly_marks_dev_password@db:5432/friendly_marks

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=friendly_marks_admin
MINIO_ROOT_PASSWORD=friendly_marks_dev_password
MINIO_BUCKET=friendly-marks-documents
MINIO_ENDPOINT=storage:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_SSL=false

# --- API ---
API_SECRET_KEY=change-me-to-a-long-random-string-in-real-deployments
API_CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=fm_session
SESSION_TTL_DAYS=30

# --- Web ---
VITE_API_BASE_URL=http://localhost:8000
